{
  "name": "ledgerflow",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "./scripts/db.sh -e .env.local generate",
    "db:migrate": "./scripts/db.sh -e .env.local migrate",
    "db:push": "./scripts/db.sh -e .env.local push",
    "db:migrate:test": "./scripts/db.sh -e .env.test migrate",
    "db:push:test": "./scripts/db.sh -e .env.test push",
    "db:reset:test": "./scripts/db.sh -e .env.test reset-db",
    "db:setup:test": "./scripts/db.sh -e .env.test setup",
    "auth:generate": "dotenv -e .env.local -- pnpm dlx @better-auth/cli generate",
    "test:e2e": "dotenv -e .env.test -- playwright test",
    "test:e2e:ui": "dotenv -e .env.test -- playwright test --ui",
    "test:e2e:debug": "dotenv -e .env.test -- playwright test --debug",
    "test": "dotenv -e .env.test -- vitest run"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@hookform/resolvers": "^5.4.0",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@shadcn/react": "^0.2.1",
    "@tanstack/react-query": "^5.100.13",
    "better-auth": "^1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.3.0",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.40.0",
    "input-otp": "^1.4.2",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-easy-crop": "^5.5.7",
    "react-hook-form": "^7.76.1",
    "react-icons": "^5.7.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@next/env": "^16.3.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@tanstack/eslint-plugin-query": "^5.100.13",
    "@tanstack/react-query-devtools": "^5.100.13",
    "@types/node": "^25.9.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "baseline-browser-mapping": "^2.10.32",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "10.8.0",
    "eslint-config-next": "16.3.0",
    "jsdom": "^30.0.1",
    "shadcn": "^4.13.1",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
